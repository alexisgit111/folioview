# FolioView — Milestone 1 (browser-only)
#
# Copy to `.env.local` to override defaults. These values are compiled into the
# client bundle at build time, so NEVER put secrets here. There are no secrets
# in Milestone 1: the app has no backend, API keys or database.

# Largest PDF the local uploader accepts, in MB (default 100)
VITE_MAX_UPLOAD_MB=100

# Upper bound on the device pixels of a single rendered canvas (default 12,000,000).
# Keeps iOS Safari (limit ~16.7M px) and low-memory devices safe at high zoom.
VITE_MAX_CANVAS_PIXELS=12000000

# Pages kept rendered on each side of the current flipbook page (default 4)
VITE_FLIPBOOK_RENDER_WINDOW=4

# --- Milestone 2+ (not used yet; listed so the shape is agreed early) ---
# API_BASE_URL=
# DATABASE_URL=            # server-side only, never VITE_-prefixed
# SESSION_SECRET=          # server-side only
# STORAGE_DRIVER=local     # local | s3
